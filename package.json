{
  "name": "playwright-agentic-qa-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable Playwright UI and API framework demonstrated with Sauce Demo and DummyJSON",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "env:validate": "playwright test --list",
    "test:smoke": "playwright test --project=chromium --project=api --grep @smoke",
    "test:regression": "playwright test --project=chromium --project=api --grep @regression",
    "test:ui": "playwright test --project=chromium",
    "test:ui:all": "playwright test --project=chromium --project=firefox --project=webkit --project=mobile-chrome --project=mobile-safari",
    "test:api": "playwright test --project=api",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:dev": "cross-env APP_ENV=dev playwright test --project=chromium --project=api",
    "test:qa": "cross-env APP_ENV=qa playwright test --project=chromium --project=api",
    "test:staging": "cross-env APP_ENV=staging playwright test --project=chromium --project=api",
    "report": "playwright show-report"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.19.0",
    "cross-env": "^10.1.0",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.0",
    "eslint-plugin-playwright": "^2.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.48.0"
  }
}
