# Demonstration targets only. Copy to .env to customize locally.
APP_ENV=dev
APP_PROFILE=sauce-demo
DEV_UI_BASE_URL=https://www.saucedemo.com
DEV_API_BASE_URL=https://dummyjson.com
# Generic target credentials. Use only approved, non-production test accounts.
DEV_USERNAME=standard_user
DEV_PASSWORD=secret_sauce
DEV_LOCKED_USERNAME=locked_out_user

# QA and staging need their own target URLs and credentials.
# QA_UI_BASE_URL=
# QA_API_BASE_URL=
# QA_USERNAME=
# QA_PASSWORD=
# STAGING_UI_BASE_URL=
# STAGING_API_BASE_URL=
# STAGING_USERNAME=
# STAGING_PASSWORD=
